{
  "name": "KAI - Chat",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kai-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "aa000001-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "kai-chat"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/embeddings",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer YOUR_OPENAI_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: $json.body.question, model: 'text-embedding-ada-002' }) }}",
        "options": {}
      },
      "id": "aa000001-0000-0000-0000-000000000002",
      "name": "Embed Question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_URL/rest/v1/rpc/kai_search_chunks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_SUPABASE_ANON_KEY" },
            { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_ANON_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query_embedding: $json.data[0].embedding, target_collection_id: $('Webhook').first().json.body.collection_id, match_count: 5 }) }}",
        "options": {}
      },
      "id": "aa000001-0000-0000-0000-000000000003",
      "name": "Vector Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst chunks = Array.isArray(response) ? response : [];\nconst question = $('Webhook').first().json.body.question;\n\nconst context = chunks.length > 0\n  ? chunks.map((c, i) => `[${i + 1}] ${c.content}`).join('\\n\\n')\n  : 'Документы не найдены.';\n\nconst system = `Ты AI-ассистент. Отвечай ТОЛЬКО на основе предоставленных документов. Если информации нет — так и скажи. Указывай номер источника [1], [2] и т.д.\\n\\nДОКУМЕНТЫ:\\n${context}`;\n\nconst sources = chunks.map(c => ({\n  document_id: c.document_id,\n  excerpt: c.content.slice(0, 200)\n}));\n\nreturn [{ json: { system, question, sources } }];"
      },
      "id": "aa000001-0000-0000-0000-000000000004",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer YOUR_OPENAI_KEY" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', messages: [{ role: 'system', content: $json.system }, { role: 'user', content: $json.question }], temperature: 0.3 }) }}",
        "options": {}
      },
      "id": "aa000001-0000-0000-0000-000000000005",
      "name": "ChatGPT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_SUPABASE_URL/rest/v1/kai_chat_messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "YOUR_SUPABASE_ANON_KEY" },
            { "name": "Authorization", "value": "Bearer YOUR_SUPABASE_ANON_KEY" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([\n  { collection_id: $('Webhook').first().json.body.collection_id, user_id: $('Webhook').first().json.body.user_id || 'demo-user', role: 'user', content: $('Webhook').first().json.body.question, sources: null },\n  { collection_id: $('Webhook').first().json.body.collection_id, user_id: $('Webhook').first().json.body.user_id || 'demo-user', role: 'assistant', content: $json.choices[0].message.content, sources: $('Build Prompt').first().json.sources }\n]) }}",
        "options": {}
      },
      "id": "aa000001-0000-0000-0000-000000000006",
      "name": "Save Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "const answer = $('ChatGPT').first().json.choices[0].message.content;\nconst sources = $('Build Prompt').first().json.sources;\nreturn [{ json: { answer, sources } }];"
      },
      "id": "aa000001-0000-0000-0000-000000000007",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ answer: $json.answer, sources: $json.sources }) }}"
      },
      "id": "aa000001-0000-0000-0000-000000000008",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1740, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Embed Question", "type": "main", "index": 0 }]] },
    "Embed Question": { "main": [[{ "node": "Vector Search", "type": "main", "index": 0 }]] },
    "Vector Search": { "main": [[{ "node": "Build Prompt", "type": "main", "index": 0 }]] },
    "Build Prompt": { "main": [[{ "node": "ChatGPT", "type": "main", "index": 0 }]] },
    "ChatGPT": { "main": [[{ "node": "Save Messages", "type": "main", "index": 0 }]] },
    "Save Messages": { "main": [[{ "node": "Format", "type": "main", "index": 0 }]] },
    "Format": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
